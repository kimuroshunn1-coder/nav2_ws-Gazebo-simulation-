<?xml version="1.0"?>
<!-- 3輪独立ステアリング(スワーブ)。base_link=正三角形の重心(車軸高さ)。前方=+X, 左=+Y。
     車輪半径 0.0321 m / 三角形の一辺 0.5 m。 -->
<robot name="my_robot">
  <material name="gray"><color rgba="0.6 0.6 0.65 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <link name="base_link">
    <visual><geometry><mesh filename="package://my_robot_sim/meshes/body2.stl"/></geometry><material name="gray"/></visual>
    <collision><origin xyz="0 0 0.06" rpy="0 0 0"/><geometry><box size="0.40 0.40 0.10"/></geometry></collision>
    <inertial><origin xyz="0 0 0.05"/><mass value="8.0"/><inertia ixx="0.25" ixy="0" ixz="0" iyy="0.30" iyz="0" izz="0.50"/></inertial>
  </link>

  <link name="steer_fl">
    <inertial><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="steer_fl_joint" type="continuous">
    <parent link="base_link"/><child link="steer_fl"/>
    <origin xyz="0.14434 0.25000 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>
  <link name="wheel_fl">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0321" length="0.03"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0321" length="0.03"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="wheel_fl_joint" type="continuous">
    <parent link="steer_fl"/><child link="wheel_fl"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.01"/>
  </joint>
  <gazebo reference="wheel_fl">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>

  <link name="steer_fr">
    <inertial><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="steer_fr_joint" type="continuous">
    <parent link="base_link"/><child link="steer_fr"/>
    <origin xyz="0.14434 -0.25000 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>
  <link name="wheel_fr">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0321" length="0.03"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0321" length="0.03"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="wheel_fr_joint" type="continuous">
    <parent link="steer_fr"/><child link="wheel_fr"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.01"/>
  </joint>
  <gazebo reference="wheel_fr">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>

  <link name="steer_rr">
    <inertial><mass value="0.2"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="steer_rr_joint" type="continuous">
    <parent link="base_link"/><child link="steer_rr"/>
    <origin xyz="-0.28868 0.00000 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.05"/>
  </joint>
  <link name="wheel_rr">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0321" length="0.03"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.0321" length="0.03"/></geometry></collision>
    <inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="wheel_rr_joint" type="continuous">
    <parent link="steer_rr"/><child link="wheel_rr"/>
    <origin xyz="0 0 0"/><axis xyz="0 1 0"/>
    <dynamics damping="0.01"/>
  </joint>
  <gazebo reference="wheel_rr">
    <mu1>1.0</mu1><mu2>1.0</mu2>
  </gazebo>


  <!-- ================= ライダー: Hokuyo UTM-30LX-EW (2D, 前方180度のみ使用) =================
       底辺パイプ内側中央 = base_link 前方 0.1852 m。ライダーはそこから外側へ 60.096 mm。 -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.21"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.24530 0 0.0125" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="utm30lx_ew" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>20</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>721</samples>
            <resolution>1</resolution>
            <min_angle>-1.570796</min_angle>
            <max_angle>1.570796</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>30.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ================= IMU: LSM6DSV16X 基板 x3 (車体中央、同一姿勢と仮定) =================
       ノイズ: ジャイロ 2.8 mdps/√Hz, 加速度 60 ug/√Hz を 200Hz(帯域100Hz)で換算した概算値 -->
  <link name="imu_0_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_0_joint" type="fixed">
    <parent link="base_link"/><child link="imu_0_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_0_link">
    <sensor name="imu_0" type="imu">
      <topic>imu_0</topic>
      <gz_frame_id>imu_0_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <link name="imu_1_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_1_joint" type="fixed">
    <parent link="base_link"/><child link="imu_1_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_1_link">
    <sensor name="imu_1" type="imu">
      <topic>imu_1</topic>
      <gz_frame_id>imu_1_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <link name="imu_2_link">
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_2_joint" type="fixed">
    <parent link="base_link"/><child link="imu_2_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_2_link">
    <sensor name="imu_2" type="imu">
      <topic>imu_2</topic>
      <gz_frame_id>imu_2_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>4.9e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>5.9e-3</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="steer_fl_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="wheel_fl_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="steer_fr_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="wheel_fr_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="steer_rr_joint">
      <command_interface name="position"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
    <joint name="wheel_rr_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>CONTROLLERS_YAML</parameters>
    </plugin>
  </gazebo>
  <!-- 【シミュレーション専用】真の姿勢を出力。仮想エンコーダの元データに使う -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>ground_truth_odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>
